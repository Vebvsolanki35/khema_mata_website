VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_for_lgd_batch_import

# Optional Map Basemap Tile Override (defaults to keyless Esri World Street Map)
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
VITE_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, HERE, Garmin, USGS, NGA, &copy; OpenStreetMap contributors
# Optional CARTO API key (only needed if explicitly overriding with CARTO basemaps)
VITE_CARTO_API_KEY=
